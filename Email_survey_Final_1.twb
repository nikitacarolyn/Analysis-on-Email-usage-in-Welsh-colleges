          <zone forceUpdate='true' h='848' id='95' type-v2='text' w='75330' x='252' y='2290'>
            <formatted-text>
              <run bold='true' fontcolor='#000000' fontsize='22' underline='true'>Summary: </run>
              <run fontcolor='#000000' fontsize='18'>This report is based on an email survey conducted by Benjamin Silverstone based on UK and Welsh colleges to analyse email usage with 1010 repondants from 19 colleges.</run>
