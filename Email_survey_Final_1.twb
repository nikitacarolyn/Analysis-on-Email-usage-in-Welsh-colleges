                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='2114' id='118' type-v2='text' w='24229' x='252' y='25885'>
                  <formatted-text>
                    <run bold='true'>The department spending the most time dealing with emails is Middle Management (Academic and Business supoort) spending an average of 99.44 minutes on emails per day</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
